{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RetroToggleState",
  "description": "Schema for persisted in-engine retro mod switcher state.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "active_mode": {
      "type": "string",
      "enum": ["RETRO_5PILLAR", "VANILLA_HD"]
    },
    "hotkey_binding": {
      "type": "string",
      "default": "L3+R3"
    },
    "fade_duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "default": 200
    },
    "debounce_duration_ms": {
      "type": "integer",
      "minimum": 500,
      "maximum": 10000,
      "default": 3000
    },
    "last_updated_iso": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "active_mode",
    "hotkey_binding",
    "fade_duration_ms",
    "last_updated_iso"
  ],
  "additionalProperties": false
}
